{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Counterpart",
  "version": "0.1.0",
  "identifier": "com.scantomake.linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Counterpart",
        "width": 1320,
        "height": 860,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Make things that fit your life",
    "longDescription": "Counterpart brings your scans, design conversations and printer tools together in a private workspace.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsecret-1-0",
          "dbus-user-session",
          "avahi-utils",
          "systemd",
          "python3",
          "openssl"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
