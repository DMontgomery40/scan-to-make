{
  "name": "@scan-to-make/scan-capture",
  "version": "0.0.1",
  "private": true,
  "description": "AR capture session native module (ARKit / ARCore) for the Scan to Make D004 spike.",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "ios",
    "android",
    "ScanCapture.podspec"
  ],
  "peerDependencies": {
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "ScanCaptureSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.scantomake.scancapture"
    },
    "ios": {
      "modulesProvider": {
        "ScanCapture": "ScanCaptureModule"
      }
    }
  }
}
