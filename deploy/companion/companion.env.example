# Private host-only configuration. Copy to companion.env and chmod 600.
# Docker Compose uses raw env_file syntax: VALUE is literal, no shell quotes.
SCAN_TO_MAKE_GENERATION_PORT=9077
MCP_TRANSPORT=stdio
# Bambu's direct-LAN configuration (fill with your own printer's values):
# PRINTER_HOST=192.168.1.100
# BAMBU_MODEL=p1s
# BAMBU_SERIAL=
# BAMBU_TOKEN=
# SLICER_PATH=/opt/slicer/bin/orca-slicer
# BAMBU_PROFILES_ROOT=/opt/slicer/resources/profiles
# See README for optional slicer/runtime mounts and other backend settings.
