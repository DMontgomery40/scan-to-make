  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp-discovery": {
      "types": "./dist/mcp-discovery.d.ts",
      "import": "./dist/mcp-discovery.js"
    },
    "./stl-export": {
      "types": "./dist/stl-export.d.ts",
      "import": "./dist/stl-export.js"
