{
  "name": "@scan-to-make/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./remote-auth": {
      "types": "./dist/remote-auth.d.ts",
      "import": "./dist/remote-auth.js"
    },
    "./capture-import": {
      "types": "./dist/capture-import.d.ts",
      "import": "./dist/capture-import.js"
    },
    "./capture-converter": {
      "types": "./dist/capture-converter.d.ts",
      "import": "./dist/capture-converter.js"
    },
    "./detail-stills": {
      "types": "./dist/detail-stills.d.ts",
      "import": "./dist/detail-stills.js"
    },
    "./scan-processing": {
      "types": "./dist/scan-processing.d.ts",
      "import": "./dist/scan-processing.js"
    },
    "./instance-lock": {
      "types": "./dist/instance-lock.d.ts",
      "import": "./dist/instance-lock.js"
    }
  },
  "scripts": {
    "prebuild": "npm ci --prefix ../printer-handoff --ignore-scripts",
    "build": "npm run build --prefix ../project && npm run build --prefix ../printer-handoff && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "serve": "npm run build && node dist/server-cli.js"
  },
  "dependencies": {
    "@scan-to-make/contracts": "file:../../packages/contracts",
    "@scan-to-make/printer-handoff": "file:../printer-handoff",
    "@scan-to-make/project": "file:../project",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
