    "./generation": {
      "types": "./dist/generation.d.ts",
      "import": "./dist/generation.js"
    },
    "./remote-auth": {
      "types": "./dist/remote-auth.d.ts",
      "import": "./dist/remote-auth.js"
    },
    "./capture-import": {
      "types": "./dist/capture-import.d.ts",
