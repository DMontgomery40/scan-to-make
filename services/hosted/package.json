{
  "name": "@scan-to-make/hosted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/hosted.d.ts",
      "import": "./dist/hosted.js"
    },
    "./metering": {
      "types": "./dist/metering.d.ts",
      "import": "./dist/metering.js"
    }
  },
  "scripts": {
    "contracts:build": "npm ci --prefix ../../packages/contracts --ignore-scripts --no-audit --no-fund && npm run build --prefix ../../packages/contracts",
    "build": "npm run contracts:build && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "serve": "npm run build && node dist/hosted-cli.js"
  },
  "dependencies": {
    "@scan-to-make/contracts": "file:../../packages/contracts",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
